<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="menuCustomContracts">
  <GuiElement profile="fs25_menuContainer">
    <GuiElement profile="fs25_menuHeaderPanel">
      <Bitmap profile="fs25_menuHeaderIconBg">
        <Bitmap profile="CC_MenuHeaderIcon" id="categoryHeaderIcon"/>
      </Bitmap>
      <Text profile="fs25_menuHeaderTitle" id="categoryHeaderText"/>
      <RoundCorner profile="fs25_shopMoneyBoxBg" id="shopMoneyBoxBg"/>
      <BoxLayout profile="fs25_shopMoneyBox" id="shopMoneyBox">
        <Text profile="fs25_shopBalance" text="$l10n_cc_current_balance"/>
        <Text profile="fs25_shopMoney" id="currentBalanceText"/>
      </BoxLayout>
    </GuiElement>
    <BoxLayout profile="fs25_subCategorySelectorTabbedBox" id="subCategoryBox">
      <Button profile="fs25_subCategorySelectorTabbedTab" id="subCategoryTabs[1]" text="$l10n_cc_header_contracts" onClick="onClickContracts">
        <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background"/>
      </Button>
      <Button profile="fs25_subCategorySelectorTabbedTab" id="subCategoryTabs[2]" text="$l10n_cc_header_invoices" onClick="onClickInvoices">
        <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background"/>
      </Button>
    </BoxLayout>

    <ThreePartBitmap profile="fs25_lineSeparatorTopHighlighted" position="0px -57px"/>
    <MultiTextOption profile="fs25_subCategorySelectorTabbed" id="subCategoryPaging" position="0px -10px" onClick="updateSubCategoryPages"/>

    <GuiElement profile="fs25_subCategorySelectorTabbedContainer" id="subCategoryPages[1]">
      <GuiElement position="0px -20px">

        <ThreePartBitmap profile="fs25_primaryMenuContainerBg">
          <Bitmap profile="fs25_menuContainerArrow"/>
          <GuiElement profile="fs25_subCategoryContainer">
            <MultiTextOption profile="CC_FilterSwitcher" id="contractDisplaySwitcher" onClick="onSwitchContractDisplay" size="380px 32px" position="20px -40px"/>
            <BoxLayout profile="fs25_subCategorySelectorBox" id="contractsFilterDots" position="0px -90px">
              <RoundCorner profile="fs25_subCategorySelectorDot"/>
              <RoundCorner profile="fs25_subCategorySelectorDot"/>
              <RoundCorner profile="fs25_subCategorySelectorDot"/>
              <RoundCorner profile="fs25_subCategorySelectorDot"/>
            </BoxLayout>
            <GuiElement profile="fs25_subCategoryListContainer" id="contractsContainer">
              <Bitmap profile="fs25_subCategoryStartClipper" name="startClipper"/>
              <Bitmap profile="fs25_subCategoryStopClipper" name="endClipper"/>

              <SmoothList id="contractsTable" profile="CC_ContractList" startClipperElementName="startClipper" endClipperElementName="endClipper">
                <ListItem profile="fs25_subCategoryListItem">
                  <Bitmap profile="fs25_subCategoryListItemIcon" name="farmIcon"/>
                  <Text profile="CC_ContractListItemTitle" name="farmland"/>
                  <Text profile="CC_ContractListItemReward" name="reward"/>
                </ListItem>
              </SmoothList>

              <ThreePartBitmap profile="fs25_subCategoryListSliderBox">
                <Slider profile="fs25_listSlider" dataElementId="contractsTable" />
              </ThreePartBitmap>
            </GuiElement>
          </GuiElement>
        </ThreePartBitmap>

        <GuiElement id="noContractsContainer">
          <Text profile="CC_HeaderLeft" text="$l10n_ui_noShopItems" position="0px -150px" width="350px" />
          <ThreePartBitmap profile="fs25_contractsContentSeparator"/>
        </GuiElement>

        <Text id="noSelectedContractText" profile="CC_HeaderLeft" text="$l10n_cc_contract_empty" position="460px -230px" width="500px" />
        <GuiElement id="contractsInfoContainer" width="1087px" position="460px -5px">
          <ThreePartBitmap profile="fs25_contractsContentSeparator"/>
          <GuiElement profile="CC_ContractFarmerBox">
            <Bitmap profile="fs25_contractsFarmerImageGradient"/>
            <Bitmap profile="fs25_contractsFarmerImage" id="contractFarmImage"/>
            <Text profile="fs25_contractsFarmerName" id="contractFarmName"/>
          </GuiElement>

          <GuiElement profile="CC_ContractContractBox">
            <Text profile="fs25_contractsContractTitle" id="contractWorkType"/>
            <Text profile="fs25_contractsContractInfoTitle" text="$l10n_ui_contractsInfo"/>
            <Text profile="fs25_contractsContractInfo" id="contractDescriptionValue"/>

            <!-- Contract details SmoothList (Farmland, Start, End, Status) -->
            <SmoothList profile="CC_ContractDetailsList" id="contractDetailsList">
              <ListItem profile="fs25_contractsDetailsListItem">
                <Text profile="fs25_contractsDetailsListTitle" name="title"/>
                <Text profile="fs25_contractsDetailsListInfo" name="info"/>
              </ListItem>
            </SmoothList>

            <Text profile="CC_ContractContractReward" id="rewardTitle" text="$l10n_contract_reward:"/>
            <ThreePartBitmap profile="CC_ContractContractRewardSeparator"/>
            <Text profile="CC_ContractContractRewardValue" id="contractRewardValue"/>
          </GuiElement>

          <GuiElement profile="CC_ContractMapBox" id="mapBox">
            <Text profile="fs25_contractsContentTitle" text="$l10n_contract_position:" position="0px -30px"/>
            <InGameMapPreview profile="CC_ContractMap" id="contractMap" onDrawPostIngameMapHotspots="onDrawPostIngameMapHotspots"/>
          </GuiElement>

          <!-- <Text profile="CC_ContractTaglineRight" id="contractStatusLabel" position="0px -20px"/>
          <Text profile="CC_ContractStatus" id="contractStatusValue" position="0px -60px"/> -->


          <!-- <Text profile="CC_ContractH6" position="0px -150px" text="$l10n_cc_contract_notes_title"/>
          <Text profile="CC_ContractBody" position="0px -180px" id="contractNotesValue"/> -->
        </GuiElement>

      </GuiElement>

    </GuiElement>
    <GuiElement profile="fs25_subCategorySelectorTabbedContainer" id="subCategoryPages[2]">
      <GuiElement width="755px" position="0px 0px">
        <Text profile="CC_InvoiceTableTitle" text="$l10n_cc_invoices_inbox_title" position="20px -20px" width="350px" />
        <GuiElement profile="fs25_statisticsHeaderBox" position="0px -50px" size="715px 32px">
          <Button profile="CC_TableHeader" position="20px 0px" size="150px 32px" text="$l10n_cc_dialog_invoice_table_id" handleFocus="false" />
          <Button profile="CC_TableHeader" position="170px 0px" size="150px 32px" text="$l10n_cc_dialog_invoice_table_status" handleFocus="false" />
          <Button profile="CC_TableHeader" position="370px 0px" size="250px 32px" text="$l10n_cc_dialog_invoice_table_from" handleFocus="false" />
          <Button profile="CC_TableHeader" position="620px 0px" size="140px 32px" text="$l10n_cc_dialog_invoice_table_amount" handleFocus="false" />
          <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px -2dp" />
        </GuiElement>
        <SmoothList id="inboxInvoicesTable" profile="CC_Table" size="715px 450px" position="20px -90px">
          <ListItem profile="CC_Row">
            <Text profile="CC_RowCellLeft" position="20px 0px" name="id"/>
            <Text profile="CC_RowCellLeft" position="170px 0px" name="status"/>
            <Text profile="CC_RowCellLeft" position="370px 0px" name="from"/>
            <Text profile="CC_RowCellLeft" position="620px 0px" name="amount"/>
          </ListItem>
        </SmoothList>
        <ThreePartBitmap profile="CC_TableSlider">
          <Slider profile="fs25_listSlider" dataElementId="inboxInvoicesTable"/>
        </ThreePartBitmap>
      </GuiElement>

      <GuiElement width="755px" position="795px 0px">
        <Text profile="CC_InvoiceTableTitle" text="$l10n_cc_invoices_outbox_title" position="20px -20px" width="350px" />
        <GuiElement profile="fs25_statisticsHeaderBox" position="0px -50px" size="715px 32px">
          <Button profile="CC_TableHeader" position="20px 0px" size="150px 32px" text="$l10n_cc_dialog_invoice_table_id" handleFocus="false" />
          <Button profile="CC_TableHeader" position="170px 0px" size="150px 32px" text="$l10n_cc_dialog_invoice_table_status" handleFocus="false" />
          <Button profile="CC_TableHeader" position="370px 0px" size="250px 32px" text="$l10n_cc_dialog_invoice_table_to" handleFocus="false" />
          <Button profile="CC_TableHeader" position="620px 0px" size="140px 32px" text="$l10n_cc_dialog_invoice_table_amount" handleFocus="false" />
          <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px -2dp" />
        </GuiElement>
        <SmoothList id="outboxInvoicesTable" profile="CC_Table" size="715px 450px" position="20px -90px">
          <ListItem profile="CC_Row">
            <Text profile="CC_RowCellLeft" position="20px 0px" name="outboxId"/>
            <Text profile="CC_RowCellLeft" position="160px 0px" name="outboxStatus"/>
            <Text profile="CC_RowCellLeft" position="350px 0px" name="outboxTo"/>
            <Text profile="CC_RowCellLeft" position="600px 0px" name="outboxAmount"/>
          </ListItem>
        </SmoothList>
        <ThreePartBitmap profile="CC_TableSlider">
          <Slider profile="fs25_listSlider" dataElementId="outboxInvoicesTable"/>
        </ThreePartBitmap>
      </GuiElement>
    </GuiElement>
  </GuiElement>


  <GUIProfiles>
    <Profile name="CC_ContractFarmerBox" extends="fs25_contractsFarmerBox">
      <size value="400px 294px"/>
    </Profile>
    <Profile name="CC_ContractContractBox" extends="fs25_contractsContractBox">
      <width value="400px"/>
      <position value="0px -294px"/>
    </Profile>
    <Profile name="CC_ContractContractReward" extends="fs25_contractsContractReward">
      <position value="0px -338px"/>
    </Profile>
    <Profile name="CC_ContractContractRewardSeparator" extends="fs25_contractsContractRewardSeparator">
      <position value="0px -370px"/>
    </Profile>
    <Profile name="CC_ContractContractRewardValue" extends="fs25_contractsContractRewardValue">
      <position value="0px -368px"/>
    </Profile>
    <Profile name="CC_ContractMapBox" extends="fs25_contractsMapBox">
      <size value="550px 434px"/>
    </Profile>
    <Profile name="CC_ContractMap" extends="fs25_contractsIngameMap">
      <size value="520px 368px"/>
    </Profile>
    <Profile name="CC_ContractDetailsList" extends="fs25_contractsDetailsList">
      <position value="0px -150px"/>
    </Profile>
    <Profile name="CC_ContractDetailsInfoIcon" with="anchorTopRight">

      <position value="0px 0px"/>
    </Profile>
  </GUIProfiles>
</GUI>
