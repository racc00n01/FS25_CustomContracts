<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="CCDedicatedMenuContractsFrame">
  <GuiElement onOpen="onContractsPageRootOpen">
    <ThreePartBitmap profile="fs25_subCategoryContainerBg">
      <Bitmap profile="fs25_subCategoryContainerArrow"/>
    </ThreePartBitmap>
    <Bitmap profile="fs25_subCategoryContainer">
      <MultiTextOption profile="fs25_subCategorySelector" id="contractDisplaySwitcher" onClick="onSwitchContractDisplay"/>
      <BoxLayout profile="fs25_subCategorySelectorBox" id="contractsFilterDots">
        <RoundCorner profile="fs25_subCategorySelectorDot"/>
        <RoundCorner profile="fs25_subCategorySelectorDot"/>
        <RoundCorner profile="fs25_subCategorySelectorDot"/>
        <RoundCorner profile="fs25_subCategorySelectorDot"/>
      </BoxLayout>

      <GuiElement profile="fs25_subCategoryListContainer" id="contractsContainer">
        <Bitmap profile="fs25_subCategoryStartClipper" name="startClipper"/>
        <Bitmap profile="fs25_subCategoryStopClipper" name="endClipper"/>

        <SmoothList id="contractsTable" profile="fs25_subCategoryList" startClipperElementName="startClipper" endClipperElementName="endClipper">
          <ListItem profile="fs25_subCategoryListItem">
            <Bitmap profile="fs25_subCategoryListItemIcon" name="farmIcon"/>
            <Text profile="CC_ContractListItemTitle" name="farmland"/>
            <Text profile="CC_ContractListItemReward" name="reward"/>
          </ListItem>
        </SmoothList>

        <ThreePartBitmap profile="fs25_subCategoryListSliderBox">
          <Slider profile="fs25_listSlider" dataElementId="contractsTable"/>
        </ThreePartBitmap>
      </GuiElement>
    </Bitmap>


    <GuiElement profile="fs25_menuContentContainer">
      <Text profile="fs25_contractsEmptyText" id="noContractsText" text="$l10n_contract_noContractsAvailable"/>
    </GuiElement>

    <GuiElement id="contractsInfoContainer" profile="fs25_menuContentContainer">
      <ThreePartBitmap profile="fs25_contractsContentSeparator"/>
      <GuiElement profile="fs25_menuHeaderPanel" position="0px 74px">
        <Bitmap profile="fs25_menuHeaderIconBg">
          <Bitmap profile="fs25_menuHeaderIcon" id="categoryHeaderIcon"/>
        </Bitmap>
        <Text profile="fs25_menuHeaderTitle" text="$l10n_cc_header_contracts" id="categoryHeaderText"/>
        <RoundCorner profile="fs25_shopMoneyBoxBg" id="shopMoneyBoxBg"/>
        <BoxLayout profile="fs25_shopMoneyBox" id="shopMoneyBox">
          <Text profile="fs25_shopBalance" text="$l10n_cc_current_balance"/>
          <Text profile="fs25_shopMoney" id="currentBalanceText"/>
        </BoxLayout>
      </GuiElement>
      <GuiElement profile="fs25_contractsFarmerBox">
        <Bitmap profile="fs25_contractsFarmerImageGradient"/>
        <Bitmap profile="fs25_contractsFarmerImage" id="contractFarmImage"/>
        <Text profile="fs25_contractsFarmerName" id="contractFarmName"/>
      </GuiElement>

      <GuiElement profile="fs25_contractsContractBox">
        <Text profile="fs25_contractsContractTitle" id="contractWorkType"/>
        <Text profile="fs25_contractsContractInfoTitle" text="$l10n_ui_contractsInfo"/>
        <Text profile="fs25_contractsContractInfo" id="contractDescriptionValue"/>

        <SmoothList profile="fs25_contractsDetailsList" id="contractDetailsList">
          <ListItem profile="fs25_contractsDetailsListItem">
            <Text profile="fs25_contractsDetailsListTitle" name="title"/>
            <Text profile="fs25_contractsDetailsListInfo" name="info"/>
          </ListItem>
        </SmoothList>

        <Text profile="fs25_contractsContractReward" id="rewardTitle" text="$l10n_contract_reward:"/>
        <ThreePartBitmap profile="fs25_contractsContractRewardSeparator"/>
        <Text profile="fs25_contractsContractRewardValue" id="contractRewardValue"/>
      </GuiElement>

      <GuiElement profile="fs25_contractsMapBox" id="mapBox" visible="false">
        <Text profile="fs25_contractsContentTitle" text="$l10n_contract_position:" position="0px -30px"/>
        <InGameMapPreview profile="fs25_contractsIngameMap" id="contractMap"/>
      </GuiElement>
    </GuiElement>
  </GuiElement>

  <GUIProfiles>
    <Profile name="CC_ContractFarmerBox" extends="fs25_contractsFarmerBox">
      <size value="400px 294px"/>
    </Profile>
    <Profile name="CC_ContractContractBox" extends="fs25_contractsContractBox">
      <width value="400px"/>
      <position value="0px -294px"/>
    </Profile>
    <Profile name="CC_ContractContractReward" extends="fs25_contractsContractReward">
      <position value="0px -338px"/>
    </Profile>
    <Profile name="CC_ContractContractRewardSeparator" extends="fs25_contractsContractRewardSeparator">
      <position value="0px -370px"/>
    </Profile>
    <Profile name="CC_ContractContractRewardValue" extends="fs25_contractsContractRewardValue">
      <position value="0px -368px"/>
    </Profile>
    <Profile name="CC_ContractMapBox" extends="fs25_contractsMapBox">
      <size value="550px 434px"/>
    </Profile>
    <Profile name="CC_ContractMap" extends="fs25_contractsIngameMap">
      <size value="520px 368px"/>
    </Profile>
    <Profile name="CC_ContractDetailsList" extends="fs25_contractsDetailsList">
      <position value="0px -150px"/>
    </Profile>
    <Profile name="CC_ContractDetailsInfoIcon" with="anchorTopRight">
      <position value="0px 0px"/>
    </Profile>
  </GUIProfiles>
</GUI>
