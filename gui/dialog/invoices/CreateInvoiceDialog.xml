<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="createInvoiceDialog" onOpen="onOpen" onClose="onClose" onCreate="onCreate">
  <GuiElement profile="newLayer" />
  <Bitmap profile="dialogFullscreenBg" id="dialogBg" />
  <GuiElement profile="fs25_dialogBg" id="dialogElement" size="0.45 0.8">
    <ThreePartBitmap profile="fs25_dialogBgMiddle" />
    <ThreePartBitmap profile="fs25_dialogBgTop" />
    <ThreePartBitmap profile="fs25_dialogBgBottom" />

    <GuiElement profile="fs25_dialogContentContainer">
      <Text profile="dialogTitle" text="Create invoice" position="0px -30px"/>

      <BoxLayout flowDirection="vertical" width="0.425" position="15px -100px" elementSpacing="5px" extends="emptyPanel" with="anchorTopLeft">
        <!-- Title -->
        <Text text="Title" profile="CC_ContractInputLabel"/>
        <TextInput profile="CC_InputTextArea" id="titleInput" onEnterPressed="onEnterPressed" onTextChanged="onTextChanged" enterWhenClickOutside="false">
          <ThreePartBitmap profile="fs25_textInputBg" absoluteSizeOffset="0px 0px"/>
        </TextInput>

        <!-- Description -->
        <Text text="$l10n_cc_dialog_create_input_description" profile="CC_ContractInputLabel" />
        <TextInput profile="CC_InputTextArea" id="descriptionInput" onEnterPressed="onEnterPressed" onTextChanged="onTextChanged" enterWhenClickOutside="false">
          <ThreePartBitmap profile="fs25_textInputBg" absoluteSizeOffset="0px 0px"/>
        </TextInput>

        <!-- To farm -->
        <Text text="Reciever farm" profile="CC_ContractInputLabel" />
        <MultiTextOption id="receiverSelector" profile="fs25_multiTextOption" size="100% 44px" onClick="onGroupSelectChange">
          <Text profile="fs25_multiTextOptionText" name="text" />
        </MultiTextOption>

        <!-- Due date -->
        <Text text="Due date" profile="CC_ContractInputLabel" />
        <MultiTextOption id="dueDateSelector" profile="fs25_multiTextOption" size="100% 44px" onClick="onDueDateSelectChange">
          <Text profile="fs25_multiTextOptionText" name="text" />
        </MultiTextOption>

        <!-- Total -->
        <Text text="Total" profile="CC_ContractInputLabel"/>
        <TextInput profile="CC_Input" id="totalInput" onEnterPressed="onEnterPressed" onTextChanged="onTextChanged" enterWhenClickOutside="false">
          <ThreePartBitmap profile="fs25_textInputBg" absoluteSizeOffset="0px 0px"/>
        </TextInput>

        <GuiElement profile="fs25_statisticsHeaderBox">
          <Button profile="CC_TableHeader" position="20px 0px" size="200px 32px" text="Title" handleFocus="false" />
          <Button profile="CC_TableHeaderRight" position="0.325 0px" size="160px 32px" text="Amount" handleFocus="false" />
          <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px -2dp" />
        </GuiElement>
        <SmoothList id="invoiceLineTable" profile="CC_Table" size="100% 200px">
          <ListItem profile="CC_Row">
            <Text profile="CC_RowCellLeft" position="20px 0px" name="title"/>
            <Text profile="CC_RowCellRight" position="-20px 0px" name="amount"/>
          </ListItem>
        </SmoothList>

      </BoxLayout>
    </GuiElement>

    <BoxLayout profile="fs25_dialogButtonBox">
      <Button profile="buttonBack" text="$l10n_cc_dialog_create_btn_cancel" onClick="onCancel" />
      <Button profile="buttonOK" text="Add line" onClick="onAddInvoiceLine" />
      <Button profile="buttonOK" text="Save as draft" onClick="onSaveAsDraft" />
      <Button profile="buttonOK" text="Create and send" onClick="onConfirm" />
    </BoxLayout>
  </GuiElement>

  <GUIProfiles>

  </GUIProfiles>
</GUI>
