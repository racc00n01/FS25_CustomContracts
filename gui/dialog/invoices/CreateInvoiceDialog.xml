<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="createInvoiceDialog" onOpen="onOpen" onClose="onClose" onCreate="onCreate">
  <GuiElement profile="newLayer" />
  <Bitmap profile="dialogFullscreenBg" id="dialogBg" />
  <GuiElement profile="fs25_dialogBg" id="dialogElement" size="900px 800px">
    <ThreePartBitmap profile="fs25_dialogBgMiddle" />
    <ThreePartBitmap profile="fs25_dialogBgTop" />
    <ThreePartBitmap profile="fs25_dialogBgBottom" />

    <GuiElement profile="fs25_dialogContentContainer">
      <Text profile="dialogTitle" text="Create invoice" position="0px -30px"/>

      <BoxLayout flowDirection="vertical" position="15px -100px">
        <BoxLayout flowDirection="vertical" size="435px 400px" elementSpacing="5px" extends="emptyPanel" with="anchorTopLeft">

          <!-- Title -->
          <Text text="Title" profile="CC_ContractInputLabel"/>
          <TextInput profile="CC_InputTextArea" id="titleInput" onEnterPressed="onEnterPressed" onTextChanged="onTextChanged" enterWhenClickOutside="false">
            <ThreePartBitmap profile="fs25_textInputBg" absoluteSizeOffset="0px 0px"/>
          </TextInput>

          <!-- To farm -->
          <Text text="Reciever farm" profile="CC_ContractInputLabel" />
          <MultiTextOption id="receiverSelector" profile="fs25_multiTextOption" size="100% 44px" onClick="onGroupSelectChange">
            <Text profile="fs25_multiTextOptionText" name="text" />
          </MultiTextOption>

          <!-- Total -->
          <Text text="Total" profile="CC_ContractInputLabel"/>
          <TextInput profile="CC_Input" id="totalInput" onEnterPressed="onEnterPressed" onTextChanged="onTextChanged" enterWhenClickOutside="false">
            <ThreePartBitmap profile="fs25_textInputBg" absoluteSizeOffset="0px 0px"/>
          </TextInput>

          <!-- Description -->
          <Text text="$l10n_cc_dialog_create_input_description" profile="CC_ContractInputLabel" />
          <TextInput profile="CC_InputTextArea" id="descriptionInput" onEnterPressed="onEnterPressed" onTextChanged="onTextChanged" enterWhenClickOutside="false">
            <ThreePartBitmap profile="fs25_textInputBg" absoluteSizeOffset="0px 0px"/>
          </TextInput>


        </BoxLayout>
      </BoxLayout>
    </GuiElement>

    <BoxLayout profile="fs25_dialogButtonBox">
      <Button profile="buttonBack" text="$l10n_cc_dialog_create_btn_cancel" onClick="onCancel" />
      <Button profile="buttonOK" text="$l10n_cc_dialog_create_btn_create" onClick="onConfirm" />
    </BoxLayout>
  </GuiElement>

  <GUIProfiles>

  </GUIProfiles>
</GUI>
