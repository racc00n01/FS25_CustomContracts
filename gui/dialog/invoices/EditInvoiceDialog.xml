<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="editInvoiceDialog" onOpen="onOpen" onClose="onClose" onCreate="onCreate">
  <GuiElement profile="newLayer" />
  <Bitmap profile="dialogFullscreenBg" id="dialogBg" />
  <GuiElement profile="fs25_dialogBg" id="dialogElement" size="0.40 0.8">
    <ThreePartBitmap profile="fs25_dialogBgMiddle" />
    <ThreePartBitmap profile="fs25_dialogBgTop" />
    <ThreePartBitmap profile="fs25_dialogBgBottom" />

    <GuiElement profile="fs25_dialogContentContainer">
      <Text profile="dialogTitle" text="$l10n_cc_dialog_create_invoice_title" position="0px -30px"/>

      <GuiElement>
        <Bitmap profile="CC_MultiTextOptionContainerLight" position="15px -75px">
          <Text text="$l10n_cc_dialog_create_invoice_title_label" profile="CC_ContractInputLabel"/>
          <TextInput profile="CC_Input" id="titleInput" onEnterPressed="onEnterPressed" onTextChanged="onTextChanged" enterWhenClickOutside="false">
            <ThreePartBitmap profile="fs25_textInputBg" absoluteSizeOffset="0px 0px"/>
            <Bitmap profile="fs25_textInputIconBox" position="0px 0px">
              <Bitmap profile="fs25_textInputIcon" />
            </Bitmap>
          </TextInput>
        </Bitmap>

        <Bitmap profile="CC_MultiTextOptionContainerDark" position="15px -125px">
          <TextInput profile="CC_Input" id="descriptionInput" onEnterPressed="onEnterPressed" onTextChanged="onTextChanged" enterWhenClickOutside="false">
            <ThreePartBitmap profile="fs25_textInputBg" absoluteSizeOffset="0px 0px"/>
            <Bitmap profile="fs25_textInputIconBox" position="0px 0px">
              <Bitmap profile="fs25_textInputIcon" />
            </Bitmap>
          </TextInput>

          <Text text="$l10n_cc_dialog_create_invoice_description_label" profile="CC_ContractInputLabel"/>
        </Bitmap>

        <Bitmap profile="CC_MultiTextOptionContainerLight" position="15px -175px">
          <MultiTextOption id="receiverSelector" profile="CC_MultiTextOption" onClick="onGroupSelectChange">
            <Text profile="fs25_multiTextOptionText" name="text" />
          </MultiTextOption>
          <Text text="$l10n_cc_dialog_create_invoice_receiver_label" profile="CC_ContractInputLabel" />
        </Bitmap>

        <Bitmap profile="CC_MultiTextOptionContainerDark" position="15px -225px">
          <Text text="$l10n_cc_dialog_create_invoice_total_label" profile="CC_ContractInputLabel"/>
          <TextInput profile="CC_Input" id="totalInput" onEnterPressed="onEnterPressed" onTextChanged="onTextChanged" enterWhenClickOutside="false">
            <ThreePartBitmap profile="fs25_textInputBg" absoluteSizeOffset="0px 0px"/>
            <Bitmap profile="fs25_textInputIconBox" position="0px 0px">
              <Bitmap profile="fs25_textInputIcon" />
            </Bitmap>
          </TextInput>
        </Bitmap>

        <Text text="$l10n_cc_dialog_create_invoice_lines_label" profile="fs25_textDefault" position="15px -325px" with="anchorTopleft"/>
        <Bitmap profile="CC_MultiTextOptionContainerDark" position="15px -350px" height="350px">
          <GuiElement profile="fs25_statisticsHeaderBox">
            <Button profile="CC_TableHeader" position="20px 0px" size="200px 32px" text="$l10n_cc_dialog_create_invoice_line_title_label" handleFocus="false" />
            <Button profile="CC_TableHeaderRight" position="0.275 0px" size="160px 32px" text="$l10n_cc_dialog_create_invoice_line_amount_label" handleFocus="false" />
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px -2dp" />
          </GuiElement>
          <SmoothList id="invoiceLineTable" profile="CC_Table" size="100% 200px">
            <ListItem profile="CC_Row">
              <Text profile="CC_RowCellLeft" position="20px 0px" name="title"/>
              <Text profile="CC_RowCellRight" position="-20px 0px" name="amount"/>
            </ListItem>
          </SmoothList>
        </Bitmap>
      </GuiElement>
    </GuiElement>

    <BoxLayout profile="fs25_dialogButtonBox">
      <Button profile="buttonBack" text="$l10n_cc_dialog_create_btn_cancel" onClick="onCancel" />
      <Button profile="buttonOK" text="$l10n_cc_dialog_create_invoice_add_line_btn" onClick="onAddInvoiceLine" />
      <Button profile="buttonOK" text="$l10n_cc_dialog_create_invoice_save_draft_btn" onClick="onSaveAsDraft" />
      <Button profile="buttonOK" text="$l10n_cc_dialog_edit_invoice_send_btn" onClick="onConfirm" />
    </BoxLayout>
  </GuiElement>
</GUI>
