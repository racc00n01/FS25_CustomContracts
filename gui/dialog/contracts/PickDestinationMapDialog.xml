<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="pickDestinationMapDialog" onOpen="onOpen" onClose="onClose" onCreate="onCreate">
  <GuiElement profile="newLayer" />
  <Bitmap profile="dialogFullscreenBg" id="dialogBg" />
  <GuiElement profile="fs25_dialogBg" id="dialogElement" size="900px 700px">
    <ThreePartBitmap profile="fs25_dialogBgMiddle" />
    <ThreePartBitmap profile="fs25_dialogBgTop" />
    <ThreePartBitmap profile="fs25_dialogBgBottom" />

    <GuiElement profile="fs25_dialogContentContainer">
      <Text profile="dialogTitle" text="$l10n_cc_dialog_pick_destination_title" position="0px -20px"/>
      <InGameMapPreview id="mapPreview" position="20px 20px" size="830px 500px" onDrawPostIngameMapHotspots="onDrawPostMapHotspots"/>
      <Text id="actionMessage" profile="fs25_textDefault" visible="false" size="200px 24px"/>
    </GuiElement>

    <BoxLayout profile="fs25_dialogButtonBox">
      <Button profile="buttonBack" text="$l10n_cc_dialog_create_btn_cancel" onClick="onCancel" />
      <Button profile="buttonOK" text="Submit" onClick="onSubmit" />
    </BoxLayout>
  </GuiElement>
</GUI>
