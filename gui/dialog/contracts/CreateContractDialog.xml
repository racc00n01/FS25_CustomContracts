<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="createContractDialog" onOpen="onOpen" onClose="onClose" onCreate="onCreate">
  <GuiElement profile="newLayer" />
  <Bitmap profile="dialogFullscreenBg" id="dialogBg" />
  <GuiElement profile="fs25_dialogBg" id="dialogElement" size="750px 600px">
    <ThreePartBitmap profile="fs25_dialogBgMiddle" />
    <ThreePartBitmap profile="fs25_dialogBgTop" />
    <ThreePartBitmap profile="fs25_dialogBgBottom" />

    <GuiElement profile="fs25_dialogContentContainer">
      <Text profile="dialogTitle" text="$l10n_cc_dialog_create_title" position="0px -30px"/>

      <GuiElement>
        <Bitmap profile="CC_MultiTextOptionContainerLight" position="15px -75px">
          <Text text="$l10n_cc_dialog_create_input_field" profile="CC_ContractInputLabel"/>
          <MultiTextOption id="fieldSelector" profile="CC_MultiTextOption" onClick="onFarmlandSelectChange">
            <Text profile="fs25_multiTextOptionText" name="text" />
          </MultiTextOption>
        </Bitmap>

        <Bitmap profile="CC_MultiTextOptionContainerDark" position="15px -125px">
          <Text text="$l10n_cc_dialog_create_input_worktype" profile="CC_ContractInputLabel" />
          <MultiTextOption id="workTypeSelector" profile="CC_MultiTextOption" onClick="onGroupSelectChange">
            <Text profile="fs25_multiTextOptionText" name="text" />
          </MultiTextOption>
        </Bitmap>

        <Bitmap profile="CC_MultiTextOptionContainerLight" position="15px -175px">
          <Text text="$l10n_cc_dialog_create_input_reward" profile="CC_ContractInputLabel"/>
          <TextInput profile="CC_Input" id="rewardInput" onEnterPressed="onEnterPressed" onTextChanged="onTextChanged" enterWhenClickOutside="false">
            <ThreePartBitmap profile="fs25_textInputBg" absoluteSizeOffset="0px 0px"/>
            <Bitmap profile="fs25_textInputIconBox" position="0px 0px">
              <Bitmap profile="fs25_textInputIcon" />
            </Bitmap>
          </TextInput>
        </Bitmap>

        <Bitmap profile="CC_MultiTextOptionContainerDark" position="15px -225px">
          <Text text="$l10n_cc_dialog_create_input_description" profile="CC_ContractInputLabel" />
          <TextInput profile="CC_Input" id="descriptionInput" onEnterPressed="onEnterPressed" onTextChanged="onTextChanged" enterWhenClickOutside="false">
            <ThreePartBitmap profile="fs25_textInputBg" absoluteSizeOffset="0px 0px"/>
            <Bitmap profile="fs25_textInputIconBox" position="0px 0px">
              <Bitmap profile="fs25_textInputIcon" />
            </Bitmap>
          </TextInput>
        </Bitmap>

        <Bitmap profile="CC_MultiTextOptionContainerLight" position="15px -275px">
          <Text text="$l10n_cc_dialog_create_input_startdate" profile="CC_ContractInputLabel" />
          <MultiTextOption id="startDateSelector" profile="CC_MultiTextOption" onClick="onStartDateSelectChange">
            <Text profile="fs25_multiTextOptionText" name="text" />
          </MultiTextOption>
        </Bitmap>

        <Bitmap profile="CC_MultiTextOptionContainerDark" position="15px -325px">
          <Text text="$l10n_cc_dialog_create_input_duedate" profile="CC_ContractInputLabel" />
          <MultiTextOption id="dueDateSelector" profile="CC_MultiTextOption" onClick="onDueDateSelectChange">
            <Text profile="fs25_multiTextOptionText" name="text" />
          </MultiTextOption>
        </Bitmap>
      </GuiElement>
    </GuiElement>

    <BoxLayout profile="fs25_dialogButtonBox">
      <Button profile="buttonBack" text="$l10n_cc_dialog_create_btn_cancel" onClick="onCancel" />
      <Button profile="buttonBack" text="$l10n_cc_dialog_create_btn_add_vehicle" onClick="onAddVehicle" />
      <Button profile="buttonOK" text="$l10n_cc_dialog_create_btn_create" onClick="onConfirm" />
    </BoxLayout>
  </GuiElement>

  <GUIProfiles>

  </GUIProfiles>
</GUI>
