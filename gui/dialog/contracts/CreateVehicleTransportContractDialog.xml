<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="createVehicleTransportContractDialog" onOpen="onOpen" onClose="onClose" onCreate="onCreate">
  <GuiElement profile="newLayer" />
  <Bitmap profile="dialogFullscreenBg" id="dialogBg" />
  <GuiElement profile="fs25_dialogBg" id="dialogElement" size="750px 680px">
    <ThreePartBitmap profile="fs25_dialogBgMiddle" />
    <ThreePartBitmap profile="fs25_dialogBgTop" />
    <ThreePartBitmap profile="fs25_dialogBgBottom" />

    <GuiElement profile="fs25_dialogContentContainer">
      <Text profile="dialogTitle" text="$l10n_cc_dialog_vehicle_transport_title" position="0px -30px"/>

      <Bitmap profile="CC_MultiTextOptionContainerDark" position="15px -90px" height="300px">
        <GuiElement profile="fs25_statisticsHeaderBox">
          <Button profile="CC_TableHeader" position="8px 0px" size="24px 32px" handleFocus="false" />
          <Button profile="CC_TableHeader" position="40px 0px" size="360px 32px" text="$l10n_cc_dialog_vehicle_transport_vehicle" handleFocus="false" />
          <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px -2dp" />
        </GuiElement>
        <Text profile="fs25_textDefault" id="vehicleSelectionCount" position="20px -36px" size="700px 20px" text=""/>
        <Text profile="fs25_textDefault" position="20px -56px" size="700px 20px" text="$l10n_cc_dialog_vehicle_transport_multi_hint"/>
        <SmoothList id="vehicleList" profile="CC_VehicleTable" size="100% 216px" position="0px -40px">
          <ListItem profile="CC_VehicleRow">
            <Bitmap profile="CC_VehicleRowImage" name="icon" />
            <Text profile="CC_VehicleRowTitle" name="title"/>
            <Button profile="CC_checkboxButton" name="checkbox">
              <ThreePartBitmap profile="CC_checkboxBox"/>
              <Bitmap profile="CC_checkbox" name="check"/>
            </Button>
          </ListItem>
        </SmoothList>
      </Bitmap>

      <Bitmap profile="CC_MultiTextOptionContainerDark" position="15px -480px">
        <Text text="$l10n_cc_dialog_transport_destination_label" profile="CC_ContractInputLabel" />
        <Button profile="CC_PickDestinationMapButton" id="destinationText" text="172a" onClick="onDestinationClick">
          <ThreePartBitmap profile="fs25_aiCreateJobParameterBg"/>
          <Bitmap profile="fs25_aiCreateJobParameterIcon"/>
        </Button>
      </Bitmap>

      <Bitmap profile="CC_MultiTextOptionContainerLight" position="15px -530px">
        <Text text="$l10n_cc_dialog_transport_reward_label" profile="CC_ContractInputLabel"/>
        <TextInput profile="CC_Input" id="rewardInput" onEnterPressed="onEnterPressed" onTextChanged="onTextChanged" enterWhenClickOutside="false">
          <ThreePartBitmap profile="fs25_textInputBg" absoluteSizeOffset="0px 0px"/>
          <Bitmap profile="fs25_textInputIconBox" position="0px 0px">
            <Bitmap profile="fs25_textInputIcon" />
          </Bitmap>
        </TextInput>
      </Bitmap>
    </GuiElement>

    <BoxLayout profile="fs25_dialogButtonBox">
      <Button profile="buttonBack" text="$l10n_cc_dialog_create_btn_cancel" onClick="onCancel" />
      <Button profile="buttonOK" text="$l10n_cc_dialog_create_btn_create" onClick="onConfirm" />
    </BoxLayout>
  </GuiElement>
</GUI>
