<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="editTransportContractDialog" onOpen="onOpen" onClose="onClose" onCreate="onCreate">
  <GuiElement profile="newLayer" />
  <Bitmap profile="dialogFullscreenBg" id="dialogBg" />
  <GuiElement profile="fs25_dialogBg" id="dialogElement" size="750px 820px">
    <ThreePartBitmap profile="fs25_dialogBgMiddle" />
    <ThreePartBitmap profile="fs25_dialogBgTop" />
    <ThreePartBitmap profile="fs25_dialogBgBottom" />

    <GuiElement profile="fs25_dialogContentContainer">
      <Text profile="dialogTitle" text="$l10n_cc_dialog_edit_title" position="0px -30px"/>

      <Bitmap profile="CC_MultiTextOptionContainerDark" position="15px -90px" height="180px">
        <GuiElement profile="fs25_statisticsHeaderBox">
          <Button profile="CC_TableHeader" position="8px 0px" size="24px 32px" handleFocus="false" />
          <Button profile="CC_TableHeader" position="40px 0px" size="240px 32px" text="$l10n_cc_dialog_transport_inventory_product" handleFocus="false" />
          <Button profile="CC_TableHeaderRight" position="-20px 0px" size="120px 32px" text="$l10n_cc_dialog_transport_inventory_amount" handleFocus="false" />
          <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px -2dp" />
        </GuiElement>
        <SmoothList id="inventoryList" profile="CC_Table" size="100% 200px">
          <ListItem profile="CC_Row">
            <Bitmap profile="CC_RowCellLeftImage" name="icon" />
            <Text profile="CC_RowCellLeft" position="40px 0px" name="title"/>
            <Text profile="CC_RowCellRight" position="-20px 0px" name="amount"/>
          </ListItem>
        </SmoothList>
      </Bitmap>

      <Bitmap profile="CC_MultiTextOptionContainerLight" position="15px -350px">
        <Text text="$l10n_cc_dialog_transport_amount_label" profile="CC_ContractInputLabel"/>
        <TextInput profile="CC_Input" id="transportAmountInput" onEnterPressed="onEnterPressed" onTextChanged="onTextChanged" enterWhenClickOutside="false">
          <ThreePartBitmap profile="fs25_textInputBg" absoluteSizeOffset="0px 0px"/>
          <Bitmap profile="fs25_textInputIconBox" position="0px 0px">
            <Bitmap profile="fs25_textInputIcon" />
          </Bitmap>
        </TextInput>
      </Bitmap>

      <Bitmap profile="CC_MultiTextOptionContainerDark" position="15px -400px">
        <Text text="$l10n_cc_dialog_transport_destination_label" profile="CC_ContractInputLabel" />
        <Button profile="CC_PickDestinationMapButton" id="destinationText" text="172a" onClick="onDestinationClick">
          <ThreePartBitmap profile="fs25_aiCreateJobParameterBg"/>
          <Bitmap profile="fs25_aiCreateJobParameterIcon"/>
        </Button>
      </Bitmap>

      <Bitmap profile="CC_MultiTextOptionContainerLight" position="15px -450px">
        <Text text="$l10n_cc_dialog_edit_input_reward" profile="CC_ContractInputLabel"/>
        <TextInput profile="CC_Input" id="rewardInput" onEnterPressed="onEnterPressed" onTextChanged="onTextChanged" enterWhenClickOutside="false">
          <ThreePartBitmap profile="fs25_textInputBg" absoluteSizeOffset="0px 0px"/>
          <Bitmap profile="fs25_textInputIconBox" position="0px 0px">
            <Bitmap profile="fs25_textInputIcon" />
          </Bitmap>
        </TextInput>
      </Bitmap>

      <Bitmap profile="CC_MultiTextOptionContainerDark" position="15px -500px">
        <Text text="$l10n_cc_dialog_edit_input_startdate" profile="CC_ContractInputLabel" />
        <MultiTextOption id="startDateSelector" profile="CC_MultiTextOption" onClick="onStartDateSelectChange">
          <Text profile="fs25_multiTextOptionText" name="text" />
        </MultiTextOption>
      </Bitmap>

      <Bitmap profile="CC_MultiTextOptionContainerLight" position="15px -550px">
        <Text text="$l10n_cc_dialog_edit_input_duedate" profile="CC_ContractInputLabel" />
        <MultiTextOption id="dueDateSelector" profile="CC_MultiTextOption" onClick="onDueDateSelectChange">
          <Text profile="fs25_multiTextOptionText" name="text" />
        </MultiTextOption>
      </Bitmap>
    </GuiElement>

    <BoxLayout profile="fs25_dialogButtonBox">
      <Button profile="buttonBack" text="$l10n_cc_dialog_edit_btn_cancel" onClick="onCancel" />
      <Button profile="buttonOK" text="$l10n_cc_dialog_edit_btn_edit" onClick="onConfirm" />
    </BoxLayout>
  </GuiElement>

  <GUIProfiles>
  </GUIProfiles>
</GUI>
